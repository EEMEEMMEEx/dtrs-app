# โปรเจกต์นี้ขึ้น Git เฉพาะ: backend/, frontend/, .agents/, README PLAN AGENT_INSTRUCTIONS AGENTS TASK STATUS
# ทุกอย่างที่ root นอกจากรายการด้านล่าง — ไม่ติดตาม
/*
!/backend/
!/frontend/
!/.agents/
!/.agents/**
!/README.md
!/CHANGELOG.md
!/minio.md
!/PLAN.md
!/AGENT_INSTRUCTIONS.md
!/AGENTS.md
!/TASK.md
!/STATUS.md
!/package.json
!/package-lock.json
!.gitignore
!.gitlab-ci.yml
!docker-compose.yml
!docker-compose.prod.yml
!.dockerignore
!.gitattributes
!/docker/
!/docker/**
!/.husky/
!/.husky/**

# CI / Docker smoke + size gates + changelog SemVer bump
!/scripts/
!/scripts/**

# เอกสาร root (เช่น flow อีเมล, mapping CSV)
!/docs/
!/docs/**

# ให้ติดตามเนื้อหาในโฟลเดอร์ที่อนุญาต (ชัดเจนกรณี Git เวอร์ชันเก่า)
!/backend/**
!/frontend/**

# ไม่ขึ้น repo: ความลับ, build, dependency (ใช้ร่วมกับ .gitignore ย่อยในแต่ละโฟลเดอร์)
**/.env
**/.env.*
!**/.env.example
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/
**/.turbo/
**/coverage/
*.log
.DS_Store
Thumbs.db
