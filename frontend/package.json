    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.577.0",
    "next": "^15.5.18",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-select": "^5.10.2",
    "recharts": "^2.15.4",
    "socket.io-client": "^4.8.3",
