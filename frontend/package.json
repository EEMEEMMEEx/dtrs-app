    "prebuild": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npx --yes tsx --test src/lib/reactSelectGlassStyles.test.ts src/lib/jobsListCsvExport.test.ts src/lib/docTicketNo.test.ts src/lib/jobImageUpload.test.ts src/lib/jobImageProxyFallback.test.ts src/lib/jobFixImageSlots.test.ts src/lib/reportPdfConstants.test.ts src/lib/formatRoleLabel.test.ts src/lib/userManagementAccess.test.ts src/lib/outOfContractAccess.test.ts src/lib/stripReopenAuditFromFixNote.test.ts src/lib/glitchtipTunnel.test.ts src/lib/sentryEnv.test.ts src/lib/safePerformance.test.ts src/components/jobs/JobClassifyDocDialog.test.ts src/lib/clientApiBase.test.ts src/lib/auth/permissions.test.ts src/lib/auth/navMenu.test.ts",
    "test:permissions": "npx --yes tsx --test src/lib/auth/permissions.test.ts src/lib/auth/navMenu.test.ts",
    "test:client-api": "npx --yes tsx --test src/lib/clientApiBase.test.ts",
    "test:users-rbac": "npx --yes tsx --test src/lib/userManagementAccess.test.ts",
    "test:role-label": "npx --yes tsx --test src/lib/formatRoleLabel.test.ts",
    "test:react-select": "npx --yes tsx --test src/lib/reactSelectGlassStyles.test.ts",
    "test:meeting": "npx --yes tsx --test src/lib/jobsListCsvExport.test.ts",
    "security:audit": "npm audit --audit-level=moderate",
    "security:audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "security:outdated": "npm outdated"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@sentry/nextjs": "^10.73.0",
    "axios": "^1.13.6",
