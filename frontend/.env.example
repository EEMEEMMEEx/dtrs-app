# คัดลอกเป็น frontend/.env.local แล้วเติมค่าจริง (ห้าม commit .env.local)
# NEXT_PUBLIC_* ถูก bake ตอน npm run build — เปลี่ยนบน PRD ต้อง rebuild image

# --- จำเป็น (local dev: npm run dev) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4100/api
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="***"

# --- Docker compose / PRD (server-side — ไม่ส่งไป browser) ---
# npm run dev + backend บนเครื่องเดียวกัน:
# API_INTERNAL_BASE_URL=http://localhost:4100/api
# Local compose จาก host (backend map 8405):
# API_INTERNAL_BASE_URL=http://localhost:8405/api
# NEXTAUTH_URL=http://localhost:8404
# API_INTERNAL_BASE_URL=http://dtrs-app-backend:4100/api

# --- Production (ตัวอย่าง — ใช้ผ่าน GitLab Variables + build-arg) ---
# NEXT_PUBLIC_API_BASE_URL=https://dtrs-app.forth.co.th/api
# NEXTAUTH_URL=https://dtrs-app.forth.co.th
# API_INTERNAL_BASE_URL=http://dtrs-app-backend:4100/api

# --- Footer metadata (optional — fallback ก่อน DB / package.json) ---
# NEXT_PUBLIC_APP_NAME="ระบบแจ้งซ่อม"
# NEXT_PUBLIC_COMPANY_NAME="Forth Co., Ltd."
# NEXT_PUBLIC_APP_VERSION=


NEXT_TELEMETRY_DISABLED=1
# ห้ามตั้ง NODE_ENV=development ในไฟล์นี้/.env — Next โหลดตอน `next build` แล้วจะพัง prerender /404
# (`<Html> should not be imported outside of pages/_document`). `npm run build` บังคับ production อยู่แล้ว
# NODE_VERSION=22.23.4


# --- GlitchTip (Sentry-compatible) ---
# DSN จริงใส่ใน `.env` local / GitLab Variables เท่านั้น ห้าม commit
# เบราว์เซอร์ส่งผ่าน same-origin `/monitoring` (Next forward ไป SENTRY_URL)
# NEXT_PUBLIC_* bake ตอน next build — UAT/PRD ต้องตั้งตอน build:frontend
# SENTRY_DSN กับ NEXT_PUBLIC_SENTRY_DSN ต้องเป็นโปรเจกต์เดียวกัน (tunnel ล็อก project + public key)
# SENTRY_DSN=http://<key>@192.168.0.115:8700/<project-id>
# NEXT_PUBLIC_SENTRY_DSN=http://<key>@192.168.0.115:8700/<project-id>
# SENTRY_URL=http://192.168.0.115:8700
# NEXT_PUBLIC_APP_ENV=development
# NEXT_PUBLIC_APP_RELEASE=dtrs-app@0.5.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=  (ว่าง = fallback: staging/uat 1, production 0.1, local 0)