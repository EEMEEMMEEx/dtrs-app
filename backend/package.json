{
  "name": "nest-typescript-starter",
  "private": true,
  "version": "1.0.0",
  "description": "Nest TypeScript starter repository",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "puppeteer:browsers": "npx @puppeteer/browsers install chrome",
    "security:audit": "npm audit --audit-level=moderate",
    "security:audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "security:outdated": "npm outdated",
    "script:fix-job-dates-batch": "ts-node scripts/fix-job-dates-by-tickets.ts",
    "script:audit-report-future-year": "ts-node scripts/audit-job-report-future-in-year.ts",
    "script:fix-report-future-audited": "ts-node scripts/fix-job-report-future-audited.ts",
    "script:seed-locations-mssql": "ts-node scripts/seed-locations-from-mssql.ts",
    "script:seed-sites-xlsx": "ts-node scripts/seed-sites-from-xlsx.ts",
    "script:seed-sites-xlsx:dry": "ts-node scripts/seed-sites-from-xlsx.ts --dry-run",
    "script:seed-sites-xlsx:clear": "ts-node scripts/seed-sites-from-xlsx.ts --clear",
    "script:migrate-hex-tickets": "ts-node scripts/migrate-hex-tickets.ts"
  },
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.17",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/platform-socket.io": "^11.1.16",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.16",
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.4.7",
    "file-type": "^21.3.4",
    "heic-convert": "^2.1.0",
    "minio": "^8.0.4",
    "nodemailer": "^8.0.3",
    "passport-jwt": "^4.0.1",
    "puppeteer-core": "^24.40.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.5.0",
    "@swc/core": "^1.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cheerio": "^0.22.35",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.0",
    "@types/heic-convert": "^2.1.1",
    "@types/jest": "^29.5.14",
    "@types/minio": "^7.1.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "exceljs": "^4.4.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^file-type$": "<rootDir>/../test/mocks/file-type.ts"
    }
  },
  "overrides": {
    "file-type": "^21.3.4",
    "jest-util": {
      "picomatch": "^2.3.2"
    },
    "jest-haste-map": {
      "anymatch": {
        "picomatch": "^2.3.2"
      }
    },
    "micromatch": {
      "picomatch": "^2.3.2"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@swc/core"
    ]
  }
}
