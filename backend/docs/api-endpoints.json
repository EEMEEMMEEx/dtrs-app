{
  "title": "CCTV Maintenance API - รายการเส้นทาง API",
  "baseUrl": "http://localhost:4100/api",
  "updated": "2026-03-28",
  "endpoints": [
    {
      "method": "GET",
      "path": "/api",
      "auth": false,
      "description": "Health check / Hello"
    },
    {
      "method": "POST",
      "path": "/api/auth/login",
      "auth": false,
      "description": "เข้าสู่ระบบ (คืนค่า access_token, user)",
      "body": { "email": "หรือ username", "password": "รหัสผ่าน" }
    },
    {
      "method": "GET",
      "path": "/api/users/reporters",
      "auth": false,
      "description": "ดึงรายชื่อผู้แจ้งซ่อม (role=USER) สำหรับ dropdown"
    },
    {
      "method": "GET",
      "path": "/api/users/me",
      "auth": "Bearer JWT",
      "description": "โปรไฟล์ของตัวเอง"
    },
    {
      "method": "GET",
      "path": "/api/users/me/avatar",
      "auth": "Bearer JWT",
      "description": "สตรีมไบต์รูปโปรไฟล์ตัวเอง (ใช้กับ Next `/user-images/:userId`)"
    },
    {
      "method": "GET",
      "path": "/api/users/:id/avatar",
      "auth": "Bearer JWT",
      "description": "สตรีมไบต์รูปโปรไฟล์ตาม user id (ผู้ล็อกอิน)"
    },
    {
      "method": "PATCH",
      "path": "/api/users/me/password",
      "auth": "Bearer JWT",
      "description": "เปลี่ยนรหัสผ่านตัวเอง",
      "body": { "currentPassword": "", "newPassword": "" }
    },
    {
      "method": "PATCH",
      "path": "/api/users/me",
      "auth": "Bearer JWT",
      "description": "อัปเดตโปรไฟล์ตัวเอง (ชื่อ, อีเมล, เบอร์, ตำแหน่ง, รูป)",
      "body": { "name": "", "email": "", "phone": "", "position": "", "image": "" }
    },
    {
      "method": "GET",
      "path": "/api/users/assignable",
      "auth": "Bearer JWT",
      "roles": ["ADMIN", "SUPERVISOR", "STAFF"],
      "description": "รายชื่อเจ้าหน้าที่ที่มอบหมายงานได้ (STAFF/SUPERVISOR) — สำหรับ modal มอบหมายงาน · STAFF เรียกได้เพื่อ flow รับงาน"
    },
    {
      "method": "GET",
      "path": "/api/users",
      "auth": "Bearer JWT",
      "roles": ["ADMIN"],
      "description": "รายชื่อผู้ใช้ทั้งหมด"
    },
    {
      "method": "GET",
      "path": "/api/users/:id",
      "auth": "Bearer JWT",
      "roles": ["ADMIN"],
      "description": "ดูข้อมูลผู้ใช้ตาม id"
    },
    {
      "method": "POST",
      "path": "/api/users",
      "auth": "Bearer JWT",
      "roles": ["ADMIN"],
      "description": "สร้างผู้ใช้",
      "body": { "email": "", "password": "", "name": "", "phone": "", "position": "", "role": "STAFF|ADMIN|USER|SUPERVISOR" }
    },
    {
      "method": "PATCH",
      "path": "/api/users/:id/password",
      "auth": "Bearer JWT",
      "roles": ["ADMIN"],
      "description": "เปลี่ยนรหัสผ่านผู้ใช้ (Admin)",
      "body": { "password": "" }
    },
    {
      "method": "PATCH",
      "path": "/api/users/:id",
      "auth": "Bearer JWT",
      "roles": ["ADMIN"],
      "description": "แก้ไขผู้ใช้ (ชื่อ, อีเมล, เบอร์, ตำแหน่ง, role)",
      "body": { "name": "", "email": "", "phone": "", "position": "", "role": "" }
    },
    {
      "method": "DELETE",
      "path": "/api/users/:id",
      "auth": "Bearer JWT",
      "roles": ["ADMIN"],
      "description": "ลบผู้ใช้"
    },
    {
      "method": "POST",
      "path": "/api/public/jobs",
      "auth": false,
      "description": "แจ้งซ่อม (multipart) — ฟิลด์ข้อความ + images[] (สูงสุด 3, 5MB/ไฟล์, JPG/PNG/WebP/HEIC→JPEG) + reporterAvatar (optional, กฎเดียวกัน) · description (อาการที่พบ) อย่างน้อย 10 ไม่เกิน 500 ตัวอักษร (400 ถ้าเกิน)",
      "body": {
        "province": "",
        "district": "",
        "agency": "",
        "location": "",
        "reporterName": "",
        "reporterPhone": "",
        "description": "string min 10 max 500",
        "images": "0–3 ไฟล์รูป",
        "reporterAvatar": "optional 1 ไฟล์"
      }
    },
    {
      "method": "POST",
      "path": "/api/jobs",
      "auth": false,
      "description": "แจ้งซ่อมใหม่ (legacy path — ใช้ POST /api/public/jobs แทน)",
      "body": { "province": "", "district": "", "location": "", "reporterName": "", "reporterPhone": "", "reporterEmail": "", "description": "", "images": [] }
    },
    {
      "method": "GET",
      "path": "/api/public/jobs/status/:ticketNo",
      "auth": false,
      "description": "ตรวจสอบสถานะด้วยเลขที่ใบ (มาสก์ — หน้าสาธารณะ)"
    },
    {
      "method": "GET",
      "path": "/api/public/jobs/status-by-phone",
      "auth": false,
      "description": "รายการงานสรุปตามเบอร์ผู้แจ้ง · query phone= (ไม่มี job id)"
    },
    {
      "method": "GET",
      "path": "/api/jobs/list",
      "auth": "Bearer JWT",
      "description": "รายการแจ้งซ่อมทั้งหมด"
    },
    {
      "method": "GET",
      "path": "/api/jobs/status/:ticketNo",
      "auth": "Bearer JWT",
      "description": "ตรวจสอบสถานะด้วยเลขที่ใบแจ้งซ่อม (ข้อมูลเต็มเมื่อล็อกอิน)"
    },
    {
      "method": "GET",
      "path": "/api/jobs/status-by-phone",
      "auth": "Bearer JWT",
      "description": "รายการงานสรุปตามเบอร์ผู้แจ้ง · query phone= (มี id สำหรับลิงก์แดชบอร์ด)"
    },
    {
      "method": "GET",
      "path": "/api/jobs/:id",
      "auth": "Bearer JWT",
      "description": "ดูงานตาม id"
    },
    {
      "method": "GET",
      "path": "/api/jobs/:id/image/:kind/:index",
      "auth": "Bearer JWT",
      "description": "สตรีมรูปงาน (proxy same-origin) · kind = issue | fix · index = 0–2"
    },
    {
      "method": "GET",
      "path": "/api/jobs/:id/report-pdf",
      "auth": "Bearer JWT",
      "description": "สร้างไฟล์ PDF รายงานการบำรุงรักษา (Chromium + emulate print)"
    },
    {
      "method": "PATCH",
      "path": "/api/jobs/:id/status",
      "auth": "Bearer JWT",
      "description": "อัปเดตสถานะงาน",
      "body": { "status": "PENDING|IN_PROGRESS|RESOLVED" }
    },
    {
      "method": "PATCH",
      "path": "/api/jobs/:id/assign",
      "auth": "Bearer JWT",
      "description": "มอบหมายงาน: มี job.assign ส่ง staffId ใครก็ได้; มี menu.pending และ staffId=ตัวเอง = รับงาน · งานไม่มีผู้รับผิดชอบ → IN_PROGRESS",
      "body": { "staffId": "number (user id ของผู้รับผิดชอบ)" }
    },
    {
      "method": "POST",
      "path": "/api/jobs/bulk-assign",
      "auth": "Bearer JWT",
      "description": "มอบหมายหลายงานพร้อมกัน (สูงสุด 50 jobIds) — สิทธิ์เดียวกับ assign · คืน updated, updatedIds, failed",
      "body": { "jobIds": "number[]", "staffId": "number" }
    },
    {
      "method": "PATCH",
      "path": "/api/jobs/:id/issue-images",
      "auth": "Bearer JWT",
      "permission": "job.issue.upload",
      "description": "อัปโหลดรูปปัญหา (multipart field images, สูงสุด 3, 5MB/ไฟล์, JPG/PNG/WebP/HEIC→JPEG) — เติมต่อได้ถึง 3 รูป ไม่แทนที่; งาน PENDING หรือ IN_PROGRESS เท่านั้น",
      "body": { "images": "ไฟล์รูป 1–3 (required อย่างน้อย 1)" }
    },
    {
      "method": "PATCH",
      "path": "/api/jobs/:id/fix",
      "auth": "Bearer JWT",
      "permission": "job.fix.self | job.fix.any",
      "description": "บันทึกการแก้ไขงาน (multipart: fixImages สูงสุด 3 × 5MB JPG/PNG/WebP/HEIC→JPEG) · คง status=IN_PROGRESS · ไม่รับลายเซ็นผู้แจ้ง",
      "body": {
        "brokenPartType": "optional",
        "fixEnvironment": "INDOOR | OUTDOOR",
        "cause": "required",
        "fixMethod": "required",
        "note": "optional",
        "oldSerialNumber": "optional",
        "newSerialNumber": "optional",
        "fixImages": "ไฟล์ (optional)"
      }
    },
    {
      "method": "PATCH",
      "path": "/api/jobs/:id/close",
      "auth": "Bearer JWT",
      "permission": "job.fix.self | job.fix.any",
      "description": "ปิดงาน (multipart: reporterSignature PNG ≤5MB) · ต้องบันทึกการแก้ไขครบก่อน · ตั้ง status=RESOLVED + fixDate",
      "body": {
        "reporterSignature": "ไฟล์ PNG (required)"
      }
    },
    {
      "method": "PATCH",
      "path": "/api/jobs/:id/reopen",
      "auth": "Bearer JWT",
      "description": "เปิดงานใหม่หลังปิด: RESOLVED → IN_PROGRESS, ล้าง fixDate, ต่อท้ายเหตุผลใน fixNote · เฉพาะผู้รับงาน (assignee)",
      "body": { "reason": "เหตุผล (required)" }
    },
    {
      "method": "PATCH",
      "path": "/api/jobs/:id/out-of-contract",
      "auth": "Bearer JWT",
      "roles": ["ADMIN", "SUPERVISOR"],
      "description": "ย้ายนอกสัญญา: ตั้ง isOutOfContract=true โดยคงสถานะ PENDING ตาม logic backend",
      "body": { "isOutOfContract": true }
    },
    {
      "method": "PATCH",
      "path": "/api/jobs/:id/classify-doc",
      "auth": "Bearer JWT",
      "permission": "job.classifyDoc (+ job.classifyDoc.contract | job.classifyDoc.outOfContract ตาม isOutOfContract)",
      "description": "จำแนกเอกสารหลัง RESOLVED: แทนที่ hex ticketNo ด้วย Running Doc No ครั้งเดียว (ในสัญญา CM-SHF-YYYY-XXXX ต้อง job.classifyDoc.contract / นอกสัญญา YYYYMM#### ต้อง job.classifyDoc.outOfContract) + ตั้ง isOutOfContract; UI: /dashboard/all และ /dashboard/jobs/:id",
      "body": { "isOutOfContract": false }
    },
    {
      "method": "PATCH",
      "path": "/api/jobs/:id/cancel",
      "auth": "Bearer JWT",
      "description": "ยกเลิกงานสถานะ PENDING → CANCELLED · สิทธิ์ job.cancel",
      "body": { "reason": "optional string max 500" }
    },
    {
      "method": "DELETE",
      "path": "/api/jobs/:id",
      "auth": "Bearer JWT",
      "description": "ลบงาน: ถ้าเป็น ADMIN และงานสถานะ IN_PROGRESS จะลบได้ทันที; มิฉะนั้นลบได้เฉพาะงาน PENDING ที่ยังไม่มีผู้รับผิดชอบ (ADMIN หรือ SUPERVISOR)"
    },
    {
      "method": "GET",
      "path": "/api/sites",
      "auth": false,
      "description": "รายการ Site เต็ม (dashboard); public report ใช้ /api/sites/options/* แทน"
    },
    {
      "method": "GET",
      "path": "/api/sites/options/provinces",
      "auth": false,
      "description": "Public cascade: รายการจังหวัดจาก Site (string[])"
    },
    {
      "method": "GET",
      "path": "/api/sites/options/districts?province=",
      "auth": false,
      "description": "Public cascade: อำเภอตามจังหวัด (string[])"
    },
    {
      "method": "GET",
      "path": "/api/sites/options/subdistricts?province=&district=",
      "auth": false,
      "description": "Public cascade: ตำบลตามจังหวัด+อำเภอ (string[])"
    },
    {
      "method": "GET",
      "path": "/api/sites/options/agencies?province=&district=&subdistrict?",
      "auth": false,
      "description": "Public cascade: สถานที่/หน่วยงาน (ตำบล optional)"
    },
    {
      "method": "GET",
      "path": "/api/sites/options/stations?province=&district=&agency=&subdistrict?",
      "auth": false,
      "description": "Public cascade: ชื่อสถานี"
    },
    {
      "method": "POST",
      "path": "/api/sites",
      "auth": "Bearer JWT",
      "description": "สร้าง Site (permission: site.create)"
    },
    {
      "method": "GET",
      "path": "/api/locations/provinces",
      "auth": false,
      "description": "รายการจังหวัด (master lazy-load)"
    },
    {
      "method": "GET",
      "path": "/api/locations/provinces/:provinceId/districts",
      "auth": false,
      "description": "อำเภอตามจังหวัด"
    },
    {
      "method": "GET",
      "path": "/api/locations/districts/:districtId/subdistricts",
      "auth": false,
      "description": "ตำบลตามอำเภอ"
    },
    {
      "method": "POST",
      "path": "/api/locations/provinces",
      "auth": "Bearer JWT",
      "description": "สร้างจังหวัด (permission: location.create)"
    },
    {
      "method": "POST",
      "path": "/api/locations/provinces/:provinceId/districts",
      "auth": "Bearer JWT",
      "description": "สร้างอำเภอ (permission: location.create)"
    },
    {
      "method": "POST",
      "path": "/api/locations/districts/:districtId/subdistricts",
      "auth": "Bearer JWT",
      "description": "สร้างตำบล (permission: location.create)"
    },
    {
      "method": "GET",
      "path": "/api/areas",
      "auth": "Bearer JWT",
      "description": "รายการพื้นที่รับผิดชอบ"
    },
    {
      "method": "POST",
      "path": "/api/areas",
      "auth": "Bearer JWT",
      "description": "สร้าง Area"
    },
    {
      "method": "GET",
      "path": "/api/settings/email-smtp",
      "auth": "Bearer JWT",
      "roles": ["ADMIN"],
      "description": "อ่านการตั้งค่า SMTP (ไม่คืนรหัสผ่าน; มี passwordSet, tlsRejectUnauthorized)"
    },
    {
      "method": "PUT",
      "path": "/api/settings/email-smtp",
      "auth": "Bearer JWT",
      "roles": ["ADMIN"],
      "description": "บันทึกการตั้งค่า SMTP (nodemailer, เก็บใน Setting key email_smtp) · password ว่าง = คงรหัสเดิม · env SMTP_TLS_REJECT_UNAUTHORIZED สำหรับ default TLS verify",
      "body": {
        "smtpHost": "",
        "smtpPort": "587",
        "username": "",
        "password": "optional — ว่างถ้าไม่เปลี่ยน",
        "secure": false,
        "from": "noreply@example.com",
        "tlsRejectUnauthorized": true
      }
    },
    {
      "method": "POST",
      "path": "/api/settings/email-smtp/test",
      "auth": "Bearer JWT",
      "roles": ["ADMIN"],
      "description": "ทดสอบส่งอีเมล (ใช้ค่าที่บันทึกแล้ว + override ฟิลด์ SMTP ได้)",
      "body": {
        "to": "recipient@example.com",
        "smtpHost": "optional override",
        "smtpPort": "optional",
        "username": "optional",
        "password": "optional",
        "secure": "optional",
        "from": "optional",
        "tlsRejectUnauthorized": "optional"
      }
    },
    {
      "method": "GET",
      "path": "/api/settings/email-templates",
      "auth": "Bearer JWT",
      "roles": ["ADMIN"],
      "description": "อ่านเทมเพลตอีเมลแจ้งงาน (Setting key email_templates: brandingLogoUrl, publicBaseUrl, onReported/onAssigned/onClosed — enabled, toExtra, cc, notifyRoleIds)"
    },
    {
      "method": "PUT",
      "path": "/api/settings/email-templates",
      "auth": "Bearer JWT",
      "roles": ["ADMIN"],
      "description": "บันทึกเทมเพลตอีเมลแจ้งงาน — flow การส่ง To/CC ดู docs/Email-Notifications.md ที่ root โปรเจกต์"
    },
    {
      "method": "GET",
      "path": "/api/roles",
      "auth": "Bearer JWT",
      "roles": ["ADMIN"],
      "description": "รายการบทบาท (AppRole) ทั้งหมด"
    },
    {
      "method": "GET",
      "path": "/api/roles/permissions",
      "auth": "Bearer JWT",
      "roles": ["ADMIN"],
      "description": "รายการสิทธิ์ (Permission) ทั้งหมด สำหรับกำหนดให้บทบาท"
    },
    {
      "method": "GET",
      "path": "/api/roles/me/permissions",
      "auth": "Bearer JWT",
      "description": "สิทธิ์ของตัวเอง (สำหรับแสดงเมนูตาม RBAC)"
    },
    {
      "method": "GET",
      "path": "/api/roles/:id",
      "auth": "Bearer JWT",
      "roles": ["ADMIN"],
      "description": "ดูบทบาทตาม id"
    },
    {
      "method": "GET",
      "path": "/api/roles/:id/permissions",
      "auth": "Bearer JWT",
      "roles": ["ADMIN"],
      "description": "รายการ permission id ที่บทบาทนี้มี"
    },
    {
      "method": "PATCH",
      "path": "/api/roles/:id/permissions",
      "auth": "Bearer JWT",
      "roles": ["ADMIN"],
      "description": "ตั้งค่าสิทธิ์ของบทบาท",
      "body": { "permissionIds": [1, 2, 3] }
    },
    {
      "method": "POST",
      "path": "/api/roles",
      "auth": "Bearer JWT",
      "roles": ["ADMIN"],
      "description": "สร้างบทบาทใหม่",
      "body": { "code": "", "name": "", "description": "" }
    },
    {
      "method": "PATCH",
      "path": "/api/roles/:id",
      "auth": "Bearer JWT",
      "roles": ["ADMIN"],
      "description": "แก้ไขบทบาท (ชื่อ, คำอธิบาย)",
      "body": { "name": "", "description": "" }
    },
    {
      "method": "DELETE",
      "path": "/api/roles/:id",
      "auth": "Bearer JWT",
      "roles": ["ADMIN"],
      "description": "ลบบทบาท (ต้องไม่มีผู้ใช้ผูกอยู่)"
    }
  ]
}
