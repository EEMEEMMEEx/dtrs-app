# คัดลอกเป็น backend/.env แล้วเติมค่าจริง (ห้าม commit .env)
# เอกสารเพิ่ม: ../docs/minio.md, ../README.md

# --- จำเป็น ---
DATABASE_URL="mysql://USER:***@localhost:3306/dtrs_app"
JWT_SECRET="***"

# --- Server ---
PORT=4100
NODE_ENV=development
# Production: คั่นด้วย comma ถ้ามีหลาย origin
ALLOWED_ORIGINS="http://localhost:3000"
# ลิงก์หน้าเว็บสำหรับ PDF (Puppeteer) และ fallback อีเมล
FRONTEND_BASE_URL="http://localhost:3000"

# --- MinIO ---
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="***"
MINIO_SECRET_KEY="***"
MINIO_BUCKET_NAME="dtrs-app"
# ⏸️ รอทีม infra สร้าง bucket บน MinIO server ก่อนทดสอบอัปโหลดรูป
# prefix URL รูปที่เก็บใน DB (browser / public)
# MINIO_PUBLIC_URL="https://minio-it.forth.co.th"
# Fallback MinIO server เมื่อ primary endpoint เชื่อมต่อไม่ได้ (ETIMEDOUT / ECONNREFUSED)
# MINIO_FALLBACK_ENDPOINT="192.168.0.71"
# MINIO_FALLBACK_PORT="9000"
# MINIO_FALLBACK_USE_SSL="false"
# MINIO_TIMEOUT_MS="5000"
# Nest โหลด object ทาง HTTP ภายใน LAN (เมื่อ public URL จาก container ใช้ไม่ได้)
# MINIO_SERVER_FETCH_BASE_URL="http://192.168.x.x:9000"
MINIO_STARTUP_CHECK="true"
MINIO_AUTO_CREATE_BUCKET="true"
MINIO_ENSURE_PUBLIC_READ_POLICY="false"

# --- SMTP (optional override; ค่าหลักตั้งในหน้า /dashboard/settings) ---
# SMTP_TLS_REJECT_UNAUTHORIZED="false"

# --- PDF local dev (Windows — ถ้าไม่ใช้ Chromium ใน Docker) ---
# PUPPETEER_EXECUTABLE_PATH="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
# CHROME_BIN=
# GOOGLE_CHROME_BIN=

# --- สคริปต์ one-off (ไม่จำเป็นสำหรับรัน API ปกติ) ---
# DRY_RUN="true"
# APPLY_WRITE="0"
# AUDIT_YEAR="2026"
# FIX_BY_YEAR="2026"
# JOB_ID=
# LIMIT=
