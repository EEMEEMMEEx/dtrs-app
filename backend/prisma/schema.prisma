generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

model AppRole {
  id          Int      @id @default(autoincrement())
  code        String   @unique // ADMIN, STAFF, USER หรือชื่อที่กำหนดเอง
  name        String   // ชื่อแสดง เช่น ผู้ดูแลระบบ
  description String?  @db.Text
  badgeTextColor String? @db.VarChar(7) // เช่น #E2E8F0
  badgeBgColor   String? @db.VarChar(7) // เช่น #1E3A8A
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]   @relation("UserRole")
  permissions RolePermission[]
}

model Permission {
  id          Int      @id @default(autoincrement())
  code        String   @unique // menu.dashboard, menu.users, ...
  name        String
  category    String?  // menu, api
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         AppRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model User {
  id           Int      @id @default(autoincrement())
  email        String?  @unique
  username     String   @unique
  password     String
  name         String?
  /// AppRole.code (รวมบทบาทที่สร้างเอง เช่น ADMIN_1) — ไม่ใช้ Prisma enum เพื่อไม่ให้ findMany พัง
  role         String   @default("STAFF") @db.VarChar(64)
  roleId       Int? // ถ้ามีค่า ใช้สิทธิ์จากตาราง Role/Permission
  roleRef      AppRole? @relation("UserRole", fields: [roleId], references: [id])
  phone        String?
  position     String? // ตำแหน่ง
  image        String? // รูปภาพ
  signature    String? // ลายเซ็นเจ้าหน้าที่ (MinIO URL)
  isLocked     Boolean  @default(false) // ล็อกการเข้าสู่ระบบ (ADMIN ตั้งได้)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  jobs          Job[]    @relation("AssignedJobs")
  jobsAssignedBy Job[]   @relation("AssignedJobsBy")
  reportedJobs Job[]    @relation("ReportedJobs")
  areas        Area[] // พื้นที่รับผิดชอบ
}

model Area {
  id        Int      @id @default(autoincrement())
  district  String // อำเภอ
  staffId   Int
  staff     User     @relation(fields: [staffId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Province master (paired with District)
model Province {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  districts District[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// District belongs to one Province
model District {
  id           Int           @id @default(autoincrement())
  name         String
  provinceId   Int
  province     Province      @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  subdistricts Subdistrict[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([provinceId, name])
}

// Subdistrict (ตำบล) belongs to one District
model Subdistrict {
  id         Int      @id @default(autoincrement())
  name       String
  districtId Int
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([districtId, name])
}

model Site {
  id          Int      @id @default(autoincrement())
  province    String // จังหวัด (denormalize จาก master)
  district    String // อำเภอ
  subdistrict String? // ตำบล
  agency      String // สถานที่/หน่วยงาน
  station     String // ชื่อสถานี
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Job {
  id         Int       @id @default(autoincrement())
  ticketNo        String?   @unique // เลขเอกสารทางการ (Doc No) — CM-SHF-YYYY-XXXX / OOC-YYYY-XXXX
  requestTicketNo String?   @unique // เลขรับแจ้ง (Request No) — RQ-CM-YYYYXXXX / RQ-OOC-YYYYXXXX (ห้ามเขียนทับ)
  reportDate DateTime? // วัน เวลาที่แจ้งซ่อม Auto

  // Location
  province    String? // จังหวัด
  district    String? // อำเภอ
  subdistrict String? // ตำบล
  agency      String? // สถานที่/หน่วยงาน
  location    String? // ชื่อสถานี (station)

  // Reporter
  reporterId    Int?
  reporter      User?   @relation("ReportedJobs", fields: [reporterId], references: [id])
  reporterName  String? // ชื่อ-สกุล
  reporterPhone String? // เบอร์โทร
  reporterEmail String? // Email ผู้แจ้ง

  // Issue Details
  title       String?
  description String? @db.Text // ข้อขัดข้อง
  images      Json? // 1.รูปภาพขัดข้อง, 2, 3

  status JobStatus @default(PENDING)

  // Fix Details
  fixTicketNo String? // เลขที่ใบแก้ไข
  fixDate     DateTime? // วัน เวลาที่แก้ไข Auto

  assignedToId Int?
  assignedTo   User?   @relation("AssignedJobs", fields: [assignedToId], references: [id])
  // ผู้ใช้ที่กดมอบหมาย/รับงาน (JWT) — แยก มอบหมาย vs รับงานเอง เทียบกับ assignedTo
  assignedById Int?
  assignedBy   User?   @relation("AssignedJobsBy", fields: [assignedById], references: [id], onDelete: SetNull)
  fixerPhone   String? // เบอร์โทรผู้แก้ไข
  fixerEmail   String? // Email ผู้แก้ไข

  brokenPart String? @db.Text // ส่วนที่ขัดข้อง / ประเภทงาน เช่น Hardware, Software
  fixEnvironment String? // INDOOR | OUTDOOR — สถานที่ติดตั้งตอนแก้ไข
  cause      String? @db.Text // สาเหตุ
  fixMethod  String? @db.Text // วิธีแก้ไข

  oldSerialNumber String? @db.Text // S/N เดิม หรือ JSON หลายอุปกรณ์ (v1 rows)
  newSerialNumber String? @db.Text // S/N ใหม่ (legacy แถวเดียว) — หลายแถวใช้ JSON ใน oldSerialNumber เท่านั้น

  fixImages    Json? // 1.รูปการแก้ไข, 2, 3
  fixNote      String? @db.Text // หมายเหตุการแก้ไข
  systemStatus String? // สถานะระบบ

  reporterSignature String? // ลายเซ็นผู้แจ้งตอนปิดงาน (MinIO URL)
  reporterSignedAt  DateTime? // เวลาที่เซ็นปิดงาน

  isOutOfContract Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value Json
}

// ตัวนับ Doc No — IN_CONTRACT period='' (running ไม่รีเซ็ต) ; OUT_OF_CONTRACT period=YYYYMM
model DocSequence {
  id        Int      @id @default(autoincrement())
  kind      String // IN_CONTRACT | OUT_OF_CONTRACT
  period    String   @default("") // '' = ในสัญญา (ตลอดอายุ) | YYYYMM = นอกสัญญารายเดือน
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([kind, period])
}
